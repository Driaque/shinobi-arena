{
  "name": "fabled-rivals",
  "version": "0.29.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs && node scripts/check-release.mjs",
    "test": "node scripts/run-checks.mjs",
    "build": "node scripts/build.mjs",
    "verify": "npm run check && npm test && npm run build",
    "test:browser": "node scripts/run-checks.mjs --browser",
    "start": "node apps/server/index.js"
  },
  "devDependencies": {
    "https-proxy-agent": "^7.0.6",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "pixi.js": "8.22.0",
    "ws": "8.22.0",
    "esbuild": "0.25.12"
  }
}
